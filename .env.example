# Copy to .env and fill in. Every block is optional except the database:
# with no PayPal keys AgentGuard runs a MOCK PayPal; with LLM_PROVIDER=none it runs heuristics only.

# --- Database -------------------------------------------------------------
# Password for the local Postgres (npm run db:local, or docker compose up -d). Pick your own and put
# the same one in DATABASE_URL. It is fixed when the database is first created (.pgdata / the Docker volume).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/agentguard

# --- PayPal (sandbox) -----------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID shown after you add https://<public-url>/webhooks/paypal in the app settings
PAYPAL_WEBHOOK_ID=
# vault         = buyer-not-present payments with a vaulted wallet (README §8.3)
# approval_link = fallback, user approves each order on PayPal (README §8.4)
PAYPAL_FLOW=vault
# How the wallet is saved: purchase ($1.00 hold, released at once) | setup_token (vault without purchase)
PAYPAL_VAULT_METHOD=purchase
# Sandbox BUSINESS account emails, one per demo store (payees)
PAYPAL_MERCHANT_FRESHCART=
PAYPAL_MERCHANT_GADGETHUB=
PAYPAL_MERCHANT_MEGADEALZ=

# --- LLM ------------------------------------------------------------------
# anthropic | none   (none = deterministic heuristics only, no API calls)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Policy compiler + demo agent
LLM_MODEL=claude-opus-5-5
# In-request-path checks (intent, injection, categorizer, explainer) - small/fast for latency
LLM_FAST_MODEL=claude-haiku-5-5

# --- Telegram -------------------------------------------------------------
# Create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=
# polling (local dev, no public URL needed) | webhook (deployed)
TELEGRAM_MODE=polling
# Any random string; Telegram echoes it back so we can verify webhook calls
TELEGRAM_WEBHOOK_SECRET=change-me

# --- URLs -----------------------------------------------------------------
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000
STORES_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional AG Grid Enterprise key (row grouping, master-detail, integrated charts run in trial mode without it)
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
# Public dashboard URL, used for absolute links in social previews (defaults to DASHBOARD_URL)
NEXT_PUBLIC_SITE_URL=

# --- PayPal Agent Toolkit behind the firewall --------------------------------
# Which @paypal/agent-toolkit tools AgentGuard's MCP server offers: all | none | comma list (e.g. create_refund,list_invoices)
PAYPAL_TOOLKIT_TOOLS=all

# --- Public-demo abuse protection ------------------------------------------
# Requests per minute per IP across the API (tighter limits apply to AI-heavy routes)
RATE_LIMIT_PER_MINUTE=300
# Max Claude calls per day; beyond it AI checks fail safe (payments ask the human)
LLM_DAILY_CALL_LIMIT=1500
# Proxy hops to trust for the client IP (1 on Render; keeps X-Forwarded-For from being spoofed)
TRUST_PROXY_HOPS=1

# --- Agent auth (optional) -------------------------------------------------
# If set, /mcp and POST /api/payments/request require  Authorization: Bearer <key>
AGENT_API_KEY=
# Demo agent -> AgentGuard MCP endpoint
AGENTGUARD_MCP_URL=http://localhost:4000/mcp
